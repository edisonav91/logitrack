{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LogiTrack": "Data Source=./data/logitrack.db"
  },
  "Security": {
    "ApiKey": ""
  },
  "CourierAvailability": {
    "UnavailableCourierIds": [
      "99999999-9999-9999-9999-999999999999"
    ],
    "SimulateFailure": false
  },
  "EventPublishing": {
    "SimulateFailure": false,
    "MaxAttempts": 3
  },
  "DemoData": {
    "Enabled": false
  }
}
